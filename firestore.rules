rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string
        && d.size() == 10
        && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasValidParent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // --- Validation Blueprints ---
    function isValidUserLedger(data) {
      return data.keys().hasAll(['ownerId', 'allocatedBudget', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'allocatedBudget', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.allocatedBudget is number
        && data.allocatedBudget >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBank(data) {
      return data.keys().hasAll(['ownerId', 'name', 'initialBalance', 'createdDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'initialBalance', 'createdDate', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.initialBalance is number
        && isValidDateStr(data.createdDate)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTicket(data) {
      return data.keys().hasAll([
          'ownerId', 'date', 'customerName', 'journey',
          'ticketCost', 'serviceCharge', 'customerPaid',
          'paidFromAccountId', 'receivedIn', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'date', 'customerName', 'journey',
          'ticketCost', 'serviceCharge', 'customerPaid',
          'paidFromAccountId', 'receivedIn', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidDateStr(data.date)
        && data.customerName is string
        && data.customerName.size() >= 1
        && data.customerName.size() <= 100
        && data.journey is string
        && data.journey.size() <= 80
        && data.ticketCost is number
        && data.ticketCost >= 0
        && data.serviceCharge is number
        && data.customerPaid is number
        && data.customerPaid >= 0
        && isValidId(data.paidFromAccountId)
        && isValidId(data.receivedIn)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUdhar(data) {
      return data.keys().hasAll([
          'ownerId', 'date', 'personName', 'amount', 'note',
          'status', 'linkedTicketId', 'settledDate', 'settledAccountId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'date', 'personName', 'amount', 'note',
          'status', 'linkedTicketId', 'settledDate', 'settledAccountId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidDateStr(data.date)
        && data.personName is string
        && data.personName.size() >= 1
        && data.personName.size() <= 100
        && data.amount is number
        && data.amount > 0
        && data.note is string
        && data.note.size() <= 200
        && data.status is string
        && (data.status == 'pending' || data.status == 'settled')
        && data.linkedTicketId is string
        && data.linkedTicketId.size() <= 128
        && data.settledDate is string
        && data.settledDate.size() <= 10
        && data.settledAccountId is string
        && data.settledAccountId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll([
          'ownerId', 'date', 'category', 'paidTo', 'amount',
          'paidFromAccountId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'date', 'category', 'paidTo', 'amount',
          'paidFromAccountId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidDateStr(data.date)
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 80
        && data.paidTo is string
        && data.paidTo.size() >= 1
        && data.paidTo.size() <= 100
        && data.amount is number
        && data.amount > 0
        && isValidId(data.paidFromAccountId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCashAddition(data) {
      return data.keys().hasAll(['ownerId', 'date', 'amount', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'date', 'amount', 'note', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidDateStr(data.date)
        && data.amount is number
        && data.amount > 0
        && data.note is string
        && data.note.size() <= 150
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId)
        && isVerifiedOwner(userId)
        && existing().ownerId == request.auth.uid;

      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserLedger(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserLedger(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['allocatedBudget', 'updatedAt']);

      allow delete: if false;

      // Bank Accounts Subcollection
      match /banks/{bankId} {
        allow get: if isValidId(userId) && isValidId(bankId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);

        allow list: if isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(bankId)
          && isVerifiedOwner(userId)
          && isValidBank(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParent(userId);

        allow update: if isValidId(userId) && isValidId(bankId)
          && isVerifiedOwner(userId)
          && isValidBank(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasValidParent(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'initialBalance', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(bankId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);
      }

      // Ticket Bookings Subcollection
      match /tickets/{ticketId} {
        allow get: if isValidId(userId) && isValidId(ticketId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);

        allow list: if isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(ticketId)
          && isVerifiedOwner(userId)
          && isValidTicket(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParent(userId);

        allow update: if isValidId(userId) && isValidId(ticketId)
          && isVerifiedOwner(userId)
          && isValidTicket(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasValidParent(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'customerName', 'journey', 'ticketCost',
            'serviceCharge', 'customerPaid', 'paidFromAccountId',
            'receivedIn', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(ticketId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);
      }

      // Udhar / Pending Payments Subcollection
      match /udhar/{udharId} {
        allow get: if isValidId(userId) && isValidId(udharId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);

        allow list: if isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(udharId)
          && isVerifiedOwner(userId)
          && isValidUdhar(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParent(userId);

        allow update: if isValidId(userId) && isValidId(udharId)
          && isVerifiedOwner(userId)
          && isValidUdhar(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasValidParent(userId)
          && existing().status == 'pending'
          && (
            (
              incoming().status == 'pending'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'date', 'personName', 'amount', 'note', 'updatedAt'
              ])
            )
            ||
            (
              incoming().status == 'settled'
              && isValidDateStr(incoming().settledDate)
              && isValidId(incoming().settledAccountId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'settledDate', 'settledAccountId', 'updatedAt'
              ])
            )
          );

        allow delete: if isValidId(userId) && isValidId(udharId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);
      }

      // Other Expenses Subcollection
      match /expenses/{expenseId} {
        allow get: if isValidId(userId) && isValidId(expenseId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);

        allow list: if isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(expenseId)
          && isVerifiedOwner(userId)
          && isValidExpense(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParent(userId);

        allow update: if isValidId(userId) && isValidId(expenseId)
          && isVerifiedOwner(userId)
          && isValidExpense(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasValidParent(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'category', 'paidTo', 'amount', 'paidFromAccountId', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(expenseId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);
      }

      // Cash Wallet Additions Subcollection
      match /cashAdditions/{cashId} {
        allow get: if isValidId(userId) && isValidId(cashId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);

        allow list: if isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(cashId)
          && isVerifiedOwner(userId)
          && isValidCashAddition(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParent(userId);

        allow update: if isValidId(userId) && isValidId(cashId)
          && isVerifiedOwner(userId)
          && isValidCashAddition(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasValidParent(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'amount', 'note', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(cashId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParent(userId);
      }
    }
  }
}
